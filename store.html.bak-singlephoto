<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prints — Photography by Anaiah Oliver</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #faf9f6;
    --bg-soft: #f2f0eb;
    --ink: #1c1b19;
    --ink-soft: #8a8680;
    --line: #e3e0d9;
    --wall: #ede9e2;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  body{
    background:var(--bg); color:var(--ink); font-family:'Inter',sans-serif;
    min-height:100vh; -webkit-font-smoothing:antialiased;
  }
  header{ padding:4rem 7vw 2rem; border-bottom:1px solid var(--line); }
  h1{ font-family:'Fraunces',serif; font-weight:400; font-size:clamp(2rem,4vw,2.8rem); letter-spacing:-0.01em; }
  .sub{ font-size:0.9rem; color:var(--ink-soft); margin-top:0.6rem; }
  .layout{
    display:grid; grid-template-columns:1.3fr 1fr; gap:4rem;
    padding:3.5rem 7vw; align-items:start;
  }
  @media (max-width:900px){ .layout{ grid-template-columns:1fr; gap:2.5rem; } }

  /* --- Mockup stage --- */
  .stage{
    background:var(--wall);
    border-radius:2px;
    padding:3rem;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    gap:2.5rem;
    min-height:520px;
    position:relative;
    overflow:visible;
  }

  .silhouette{
    flex-shrink:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    opacity:0.28;
  }
  .silhouette svg{ display:block; }
  .silhouette-label{
    font-size:0.62rem; letter-spacing:0.05em; text-transform:uppercase;
    color:var(--ink); margin-top:0.4rem; opacity:0.7;
  }

  .print-wrap{
    perspective:1200px;
    flex-shrink:0;
    position:relative;
  }

  .print{
    position:relative;
    transform-style:preserve-3d;
    transition:width 0.35s ease, height 0.35s ease, transform 0.05s linear;
    box-shadow:0 25px 45px rgba(28,27,25,0.18), 0 6px 12px rgba(28,27,25,0.1);
    cursor:zoom-in;
  }
  .print-wrap.zoomed .print{ cursor:grab; }
  .print-wrap.zoomed .print:active{ cursor:grabbing; }
  .print img{
    display:block; width:100%; height:100%; object-fit:cover;
  }

  .zoom-btn{
    position:absolute; top:-14px; right:-14px; z-index:5;
    width:38px; height:38px; border-radius:50%;
    background:var(--ink); color:var(--bg); border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 4px 10px rgba(28,27,25,0.25);
    transition:transform 0.15s ease;
  }
  .zoom-btn:hover{ transform:scale(1.08); }

  body.zoom-active .silhouette{ opacity:0; pointer-events:none; transition:opacity 0.2s ease; }

  /* sheen overlay, moves opposite tilt */
  .sheen{
    position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(115deg, rgba(255,255,255,0) 35%, rgba(255,255,255,0.35) 48%, rgba(255,255,255,0) 60%);
    background-size:250% 250%;
    background-position:50% 50%;
    opacity:0;
    transition:opacity 0.2s ease, background-position 0.05s linear;
  }
  .print-wrap:hover .sheen{ opacity:1; }

  /* light-highlight: a moving specular hotspot, as if a fixed light source reflects
     off the surface differently depending on which way the print is turned */
  .light-highlight{
    position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(circle at 50% 50%, rgba(255,250,235,0) 0%, rgba(255,250,235,0) 100%);
    mix-blend-mode:screen;
  }

  /* light-shadow: darkens the surface as it turns away from the light, so extreme
     angles read as physically turning rather than just a flat rotated image */
  .light-shadow{
    position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(135deg, rgba(10,10,10,0) 0%, rgba(10,10,10,0) 100%);
  }

  /* metal-only magnet dots */
  .magnet{
    position:absolute; width:7px; height:7px; border-radius:50%;
    background:rgba(0,0,0,0.35); box-shadow:inset 0 0 0 1px rgba(255,255,255,0.25);
    display:none;
  }
  .print.metal .magnet{ display:block; }
  .magnet.tl{ top:10px; left:10px; }
  .magnet.tr{ top:10px; right:10px; }
  .magnet.bl{ bottom:10px; left:10px; }
  .magnet.br{ bottom:10px; right:10px; }

  /* framed poster treatment */
  .print.framed{
    padding:0;
  }
  .print.framed .frame-border{
    position:absolute; inset:0;
    border: 14px solid #4a3a2c;
    box-shadow:
      inset 0 0 0 2px rgba(0,0,0,0.25),
      inset 0 0 0 16px transparent; /* mat area, transparent for now per instruction */
    pointer-events:none;
  }
  .print.framed .mat{
    position:absolute; inset:14px;
    background: transparent; /* margins left transparent intentionally for this test pass */
    display:flex; align-items:center; justify-content:center;
  }
  .print.framed .mat img{ width:100%; height:100%; object-fit:cover; }

  .print.poster{ box-shadow:0 18px 30px rgba(28,27,25,0.14); }

  /* --- Depth edges: give the print real thickness so it reads as an object,
       not a flat plane rotating in space. Sized/positioned dynamically in JS
       since the print's own pixel dimensions change with every size pick. --- */
  .edge-right, .edge-bottom{
    position:absolute; pointer-events:none;
  }
  .edge-right{ top:0; left:0; transform-origin:left center; }
  .edge-bottom{ top:0; left:0; transform-origin:top center; }
  .print.poster .edge-right, .print.poster .edge-bottom{
    background:linear-gradient(to bottom, #efece4, #cfcabf);
  }
  .print.metal .edge-right, .print.metal .edge-bottom{
    background:linear-gradient(to bottom, #8a8d92, #4c4e52);
  }
  .print.framed .edge-right, .print.framed .edge-bottom{
    background:linear-gradient(to bottom, #5c4934, #382b1f);
  }

  /* --- Drag handle: a visible, explicit "grab this" affordance inside the lightbox --- */
  .drag-handle{
    width:56px; height:56px; border-radius:50%;
    background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.18);
    display:flex; align-items:center; justify-content:center;
    color:#f2f0eb; cursor:grab; margin-bottom:0.3rem;
    transition:background 0.15s ease, transform 0.1s ease;
  }
  .drag-handle:hover{ background:rgba(255,255,255,0.16); }
  .drag-handle:active{ cursor:grabbing; transform:scale(0.96); }
  .drag-handle-label{
    font-family:'Inter',sans-serif; font-size:0.65rem; letter-spacing:0.05em; text-transform:uppercase;
    color:rgba(242,240,235,0.5); text-align:center; margin-bottom:1.2rem;
  }

  /* --- Lightbox --- */
  .lightbox{
    position:fixed; inset:0; z-index:100;
    background:radial-gradient(circle at 50% 40%, #2a2926 0%, #131211 75%);
    display:none; align-items:center; justify-content:center;
    flex-direction:column; gap:1.6rem;
  }
  .lightbox.open{ display:flex; }
  .lightbox-stage{
    perspective:1600px;
    display:flex; align-items:center; justify-content:center;
    min-height:58vh; width:100%;
  }
  .lightbox-close{
    position:absolute; top:1.6rem; right:1.8rem;
    width:42px; height:42px; border-radius:50%;
    background:rgba(255,255,255,0.08); color:#f2f0eb; border:1px solid rgba(255,255,255,0.15);
    font-size:1rem; cursor:pointer; transition:background 0.15s ease;
  }
  .lightbox-close:hover{ background:rgba(255,255,255,0.16); }

  .pan-controls{ display:flex; flex-direction:column; align-items:center; gap:0.5rem; }
  .pan-mid-row{ display:flex; gap:0.5rem; align-items:center; }
  .pan-btn{
    width:42px; height:42px; border-radius:50%;
    background:rgba(255,255,255,0.08); color:#f2f0eb; border:1px solid rgba(255,255,255,0.15);
    font-size:1.1rem; cursor:pointer; transition:background 0.15s ease;
  }
  .pan-btn:hover{ background:rgba(255,255,255,0.18); }

  .lightbox-hint{
    font-family:'Inter',sans-serif; font-size:0.75rem; color:rgba(242,240,235,0.55);
    letter-spacing:0.02em; text-align:center;
  }

  /* --- Controls --- */
  .controls h2{
    font-family:'Fraunces',serif; font-weight:400; font-size:1.4rem; margin-bottom:0.3rem;
  }
  .controls .photo-label{ font-size:0.85rem; color:var(--ink-soft); margin-bottom:2rem; }

  .field{ margin-bottom:1.8rem; }
  .field-label{
    font-size:0.72rem; letter-spacing:0.06em; text-transform:uppercase;
    color:var(--ink-soft); margin-bottom:0.7rem; display:block;
  }

  .option-row{ display:flex; gap:0.6rem; flex-wrap:wrap; }
  .option-btn{
    font-family:'Inter',sans-serif; font-size:0.82rem; font-weight:500;
    padding:0.6rem 1rem; border:1px solid var(--line); background:var(--bg);
    color:var(--ink); cursor:pointer; transition:all 0.15s ease;
  }
  .option-btn:hover{ border-color:var(--ink-soft); }
  .option-btn.active{ background:var(--ink); color:var(--bg); border-color:var(--ink); }

  .scripture-toggle{
    display:flex; align-items:center; gap:0.7rem; margin-top:0.5rem;
  }
  .scripture-toggle input{ width:16px; height:16px; accent-color:var(--ink); }
  .scripture-toggle label{ font-size:0.85rem; color:var(--ink); cursor:pointer; }

  .price-row{
    display:flex; align-items:baseline; justify-content:space-between;
    padding:1.4rem 0; border-top:1px solid var(--line); margin-top:1rem;
  }
  .price{ font-family:'Fraunces',serif; font-size:1.9rem; }
  .price-note{ font-size:0.72rem; color:var(--ink-soft); }

  .cta{
    display:block; width:100%; text-align:center;
    background:var(--ink); color:var(--bg); font-family:'Inter',sans-serif;
    font-size:0.85rem; font-weight:500; letter-spacing:0.03em; text-transform:uppercase;
    padding:1rem; text-decoration:none; margin-top:1rem; transition:opacity 0.15s ease;
  }
  .cta:hover{ opacity:0.85; }
  .fallback-note{
    font-size:0.72rem; color:var(--ink-soft); margin-top:0.7rem; text-align:center;
  }
</style>
</head>
<body>

<header>
  <h1>Prints</h1>
  <div class="sub">Bortle 3 — Orion — choose a finish, size, and optional scripture pairing</div>
</header>

<div class="layout">

  <div class="stage" id="stage">
    <div class="silhouette">
      <svg id="silSvg" width="34" height="0" viewBox="0 0 34 100" fill="none">
        <path d="M17 0 C21 0 24 3 24 8 C24 12 22 14 20 15 L20 18 C26 20 30 26 30 34 L30 60 C30 63 28 65 25 65 L25 95 C25 98 23 100 20 100 L14 100 C11 100 9 98 9 95 L9 65 C6 65 4 63 4 60 L4 34 C4 26 8 20 14 18 L14 15 C12 14 10 12 10 8 C10 3 13 0 17 0 Z" fill="#1c1b19"/>
      </svg>
      <div class="silhouette-label">5'9" reference</div>
    </div>

    <div class="print-wrap" id="printWrap">
      <button class="zoom-btn" id="zoomBtn" aria-label="View full and rotate" title="View full and rotate">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
      </button>
      <div class="print poster" id="printEl">
        <img id="printImg" src="https://picsum.photos/seed/orion/900/1200" alt="Print preview">
        <div class="light-shadow"></div>
        <div class="sheen"></div>
        <div class="light-highlight"></div>
        <div class="magnet tl"></div>
        <div class="magnet tr"></div>
        <div class="magnet bl"></div>
        <div class="magnet br"></div>
        <div class="frame-border" style="display:none;"></div>
        <div class="mat" style="display:none;"><img src="https://picsum.photos/seed/orion/900/1200" alt=""></div>
        <div class="edge-right" id="edgeRight"></div>
        <div class="edge-bottom" id="edgeBottom"></div>
      </div>
    </div>
  </div>

  <div class="controls">
    <h2>Bortle 3 — Orion</h2>
    <div class="photo-label">Canon R6 Mark II · TTArtisan 14mm f/2.8</div>

    <div class="field">
      <span class="field-label">Finish</span>
      <div class="option-row" id="finishRow">
        <button class="option-btn active" data-finish="poster">Poster</button>
        <button class="option-btn" data-finish="metal">Metal</button>
        <button class="option-btn" data-finish="framed">Framed Poster</button>
      </div>
    </div>

    <div class="field">
      <span class="field-label">Size</span>
      <div class="option-row" id="sizeRow"></div>
    </div>

    <div class="field">
      <span class="field-label">Scripture pairing (optional, no extra cost)</span>
      <div class="option-row" id="scriptureRow">
        <button class="option-btn active" data-verse="none">None</button>
        <button class="option-btn" data-verse="ps19">Psalm 19:1</button>
        <button class="option-btn" data-verse="prov3">Proverbs 3:26</button>
      </div>
    </div>

    <div class="price-row">
      <span class="price" id="priceDisplay">$16.00</span>
      <span class="price-note" id="sizeNote">16×20 in</span>
    </div>

    <a href="#" class="cta" id="requestBtn">Request this print</a>
    <div class="fallback-note">Opens your email app, pre-filled — nothing sends automatically.</div>
  </div>

</div>

<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
  <div class="lightbox-stage" id="lightboxStage"></div>
  <div class="drag-handle" id="dragHandle" aria-label="Drag to rotate">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/>
      <polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/>
      <line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/>
    </svg>
  </div>
  <div class="drag-handle-label">drag to rotate</div>
  <div class="pan-controls">
    <button class="pan-btn" data-dir="up" aria-label="Pan up">↑</button>
    <div class="pan-mid-row">
      <button class="pan-btn" data-dir="left" aria-label="Pan left">←</button>
      <button class="pan-btn" id="panReset" aria-label="Reset view">⟳</button>
      <button class="pan-btn" data-dir="right" aria-label="Pan right">→</button>
    </div>
    <button class="pan-btn" data-dir="down" aria-label="Pan down">↓</button>
  </div>
  <div class="lightbox-hint">Drag the print, or use the arrows — the lighting shifts as you turn it.</div>
</div>

<script>
  // ---- Pricing data, from CanvasDiscount cost sheet + $6 flat frame add ----
  const PRICING = {
    poster: {
      '8x12': 5.20, '12x12': 10.67, '12x16': 13.33, '16x20': 16.00,
      '16x24': 18.67, '20x20': 20.00, '12x36': 21.33, '20x24': 22.67,
      '20x30': 22.67, '24x36': 25.33
    },
    metal: {
      '8x8': 12.00, '8x10': 20.00, '8x12': 21.33, '11x14': 34.67,
      '12x16': 36.00, '12x18': 46.67, '16x20': 65.33, '16x24': 66.67,
      '18x24': 76.00, '20x24': 116.00, '20x30': 122.67, '24x30': 133.33,
      '24x36': 140.00, '30x40': 237.33
    },
    framed: {} // derived below: poster price + $6
  };
  for (const size in PRICING.poster) {
    PRICING.framed[size] = +(PRICING.poster[size] + 6).toFixed(2);
  }

  const FINISH_LABEL = { poster: 'Poster', metal: 'Metal Print', framed: 'Framed Poster' };
  const VERSE_LABEL = { none: 'None', ps19: 'Psalm 19:1', prov3: 'Proverbs 3:26' };

  // ---- Base photo (in the real site, this comes from the selected gallery photo) ----
  const BASE_IMG = 'https://picsum.photos/seed/orion/900/1200';
  const VERSE_IMG = {
    ps19: 'https://picsum.photos/seed/ps19/900/1200',
    prov3: 'https://picsum.photos/seed/prov3/900/1200'
  };

  let state = { finish: 'poster', size: '16x20', verse: 'none' };

  const printEl = document.getElementById('printEl');
  const printImg = document.getElementById('printImg');
  const matImg = document.querySelector('.mat img');
  const frameBorder = document.querySelector('.frame-border');
  const matDiv = document.querySelector('.mat');
  const priceDisplay = document.getElementById('priceDisplay');
  const sizeNote = document.getElementById('sizeNote');
  const silSvg = document.getElementById('silSvg');
  const requestBtn = document.getElementById('requestBtn');
  const printWrap = document.getElementById('printWrap');
  const zoomBtn = document.getElementById('zoomBtn');
  const sheen = document.querySelector('.sheen');
  const lightHighlight = document.querySelector('.light-highlight');
  const lightShadow = document.querySelector('.light-shadow');
  const stageEl = document.getElementById('stage');
  const lightbox = document.getElementById('lightbox');
  const lightboxStage = document.getElementById('lightboxStage');
  const lightboxClose = document.getElementById('lightboxClose');
  const panReset = document.getElementById('panReset');
  const edgeRight = document.getElementById('edgeRight');
  const edgeBottom = document.getElementById('edgeBottom');
  const dragHandle = document.getElementById('dragHandle');

  let isZoomed = false;

  function buildSizeOptions(){
    const row = document.getElementById('sizeRow');
    row.innerHTML = '';
    const sizes = Object.keys(PRICING[state.finish]);
    if (!sizes.includes(state.size)) state.size = sizes[Math.floor(sizes.length/2)];
    sizes.forEach(size => {
      const btn = document.createElement('button');
      btn.className = 'option-btn' + (size === state.size ? ' active' : '');
      btn.textContent = size.replace('x', '×') + '"';
      btn.dataset.size = size;
      btn.addEventListener('click', () => { state.size = size; refresh(); });
      row.appendChild(btn);
    });
  }

  function applySize(){
    // A 5'9" (69in) person is often TALLER than most print sizes — that's real and correct,
    // so on the small card we scale both together off the taller of the two, keeping their
    // relative sizes honest. In the lightbox, the silhouette is hidden, so we scale purely
    // to fill the space and show detail.
    const [wIn, hIn] = state.size.split('x').map(Number);
    const PERSON_HEIGHT_IN = 69;
    const MAX_STAGE_PX = isZoomed ? Math.min(window.innerHeight * 0.58, 760) : 460;
    const tallestIn = isZoomed ? hIn : Math.max(PERSON_HEIGHT_IN, hIn);
    const pxPerInch = MAX_STAGE_PX / tallestIn;

    printEl.style.width = (wIn * pxPerInch) + 'px';
    printEl.style.height = (hIn * pxPerInch) + 'px';

    // real thickness per material — paper is nearly flat, metal has slight rigidity,
    // a framed poster has genuine depth (mat + glass + the frame itself)
    const wPx = wIn * pxPerInch;
    const hPx = hIn * pxPerInch;
    const depth = state.finish === 'framed' ? 24 : state.finish === 'metal' ? 8 : 4;
    edgeRight.style.width = depth + 'px';
    edgeRight.style.height = hPx + 'px';
    edgeRight.style.transform = `translateX(${wPx}px) rotateY(90deg)`;
    edgeBottom.style.width = wPx + 'px';
    edgeBottom.style.height = depth + 'px';
    edgeBottom.style.transform = `translateY(${hPx}px) rotateX(-90deg)`;

    // frame width scales off the SAME real-world pxPerInch as the print itself —
    // a "normal" ~1.1in frame stays visually normal whether the print renders
    // tiny (8x12) or large (24x36), instead of a fixed px border overwhelming small sizes
    const frameInches = 1.1;
    const framePx = Math.max(3, frameInches * pxPerInch);
    frameBorder.style.borderWidth = framePx + 'px';
    matDiv.style.inset = framePx + 'px';

    if (!isZoomed) {
      // silhouette scales off the SAME pxPerInch, and BOTH width and height update
      // (the original bug: only height was ever set, so the SVG stayed squashed to its
      // native 34px width no matter how tall it got — fixed by scaling both dimensions
      // together off the SVG's real 34:100 aspect ratio)
      const silHeightPx = PERSON_HEIGHT_IN * pxPerInch;
      const silWidthPx = silHeightPx * (34 / 100);
      silSvg.setAttribute('width', silWidthPx);
      silSvg.setAttribute('height', silHeightPx);
      silSvg.style.width = silWidthPx + 'px';
      silSvg.style.height = silHeightPx + 'px';
    }
  }

  function refresh(){
    // finish buttons
    document.querySelectorAll('#finishRow .option-btn').forEach(b =>
      b.classList.toggle('active', b.dataset.finish === state.finish));
    // verse buttons
    document.querySelectorAll('#scriptureRow .option-btn').forEach(b =>
      b.classList.toggle('active', b.dataset.verse === state.verse));

    buildSizeOptions();
    document.querySelectorAll('#sizeRow .option-btn').forEach(b =>
      b.classList.toggle('active', b.dataset.size === state.size));

    // image (verse overlay swap)
    const imgSrc = state.verse === 'none' ? BASE_IMG : VERSE_IMG[state.verse];
    printImg.src = imgSrc;
    matImg.src = imgSrc;

    // size scaling — proportional to real inches, dynamically fit to whichever stage is active
    applySize();

    // finish-specific styling
    printEl.classList.remove('poster', 'metal', 'framed');
    printEl.classList.add(state.finish);
    frameBorder.style.display = state.finish === 'framed' ? 'block' : 'none';
    matDiv.style.display = state.finish === 'framed' ? 'flex' : 'none';
    printImg.style.display = state.finish === 'framed' ? 'none' : 'block';

    // price
    const [wIn, hIn] = state.size.split('x').map(Number);
    const price = PRICING[state.finish][state.size];
    priceDisplay.textContent = '$' + price.toFixed(2);
    sizeNote.textContent = wIn + '×' + hIn + ' in';

    // mailto
    const subject = encodeURIComponent('Print Inquiry: Bortle 3 — Orion');
    const body = encodeURIComponent(
      `Photo: Bortle 3 — Orion\nFinish: ${FINISH_LABEL[state.finish]}\nSize: ${state.size.replace('x','x')} in\nScripture pairing: ${VERSE_LABEL[state.verse]}\nPrice: $${price.toFixed(2)}`
    );
    requestBtn.href = `mailto:anaiaholiverphotography@gmail.com?subject=${subject}&body=${body}`;
  }

  document.querySelectorAll('#finishRow .option-btn').forEach(b => {
    b.addEventListener('click', () => { state.finish = b.dataset.finish; refresh(); });
  });
  document.querySelectorAll('#scriptureRow .option-btn').forEach(b => {
    b.addEventListener('click', () => { state.verse = b.dataset.verse; refresh(); });
  });

  // ---- Rotation state, now driven by drag (zoomed only) + explicit pan buttons ----
  let rotY = -14; // resting angle so it doesn't sit dead-flat when idle
  let rotX = 4;
  let dragging = false;
  let lastX = 0, lastY = 0;

  const MAX_ROT = 45;
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

  function applyRotation(){
    printEl.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;

    const nx = rotY / MAX_ROT; // -1..1
    const ny = rotX / MAX_ROT; // -1..1

    sheen.style.backgroundPosition = `${50 - nx * 40}% ${50 + ny * 40}%`;

    // highlight: a warm hotspot that slides opposite the tilt, as if a fixed light
    // source is reflecting off the surface differently as it turns — stronger in the lightbox
    const glow = isZoomed ? 0.55 : 0.28;
    lightHighlight.style.background =
      `radial-gradient(circle at ${50 - nx * 55}% ${50 - ny * 55}%, rgba(255,250,235,${glow}) 0%, rgba(255,250,235,0) 42%)`;

    // shadow: darkens as the surface turns away, so extreme angles read as a real
    // object turning rather than a flat image being skewed
    const turn = Math.min(1, (Math.abs(nx) + Math.abs(ny)) / 1.4);
    lightShadow.style.background =
      `linear-gradient(${135 + nx * 30}deg, rgba(10,10,10,${0.28 * turn}) 0%, rgba(10,10,10,0) 55%)`;

    // faint inner rim-light, grows with rotation — reads as an edge catching light
    printEl.style.boxShadow =
      `0 25px 45px rgba(28,27,25,0.18), 0 6px 12px rgba(28,27,25,0.1), inset 0 0 0 1px rgba(255,255,255,${0.18 * turn})`;
  }

  function startDrag(x, y){
    if (!isZoomed) return; // small card no longer free-drags — click it to open the lightbox instead
    dragging = true;
    lastX = x; lastY = y;
    printEl.style.transition = 'width 0.35s ease, height 0.35s ease';
  }
  function moveDrag(x, y){
    if (!dragging) return;
    const dx = x - lastX;
    const dy = y - lastY;
    lastX = x; lastY = y;
    rotY = clamp(rotY + dx * 0.35, -MAX_ROT, MAX_ROT);
    rotX = clamp(rotX - dy * 0.35, -MAX_ROT, MAX_ROT);
    applyRotation();
  }
  function endDrag(){
    dragging = false;
    printEl.style.transition = 'width 0.35s ease, height 0.35s ease, transform 0.4s ease';
  }

  printWrap.addEventListener('mousedown', (e) => startDrag(e.clientX, e.clientY));
  window.addEventListener('mousemove', (e) => moveDrag(e.clientX, e.clientY));
  window.addEventListener('mouseup', endDrag);

  printWrap.addEventListener('touchstart', (e) => {
    const t = e.touches[0];
    startDrag(t.clientX, t.clientY);
  }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (!dragging) return;
    const t = e.touches[0];
    moveDrag(t.clientX, t.clientY);
  }, { passive: true });
  window.addEventListener('touchend', endDrag);

  // the visible handle drives the exact same rotation logic — it's just a clearer affordance
  dragHandle.addEventListener('mousedown', (e) => { e.stopPropagation(); startDrag(e.clientX, e.clientY); });
  dragHandle.addEventListener('touchstart', (e) => {
    e.stopPropagation();
    const t = e.touches[0];
    startDrag(t.clientX, t.clientY);
  }, { passive: true });

  // ---- Explicit pan buttons — a precise, no-guesswork alternative to dragging ----
  document.querySelectorAll('.pan-btn[data-dir]').forEach(btn => {
    btn.addEventListener('click', () => {
      const step = 12;
      if (btn.dataset.dir === 'up')    rotX = clamp(rotX + step, -MAX_ROT, MAX_ROT);
      if (btn.dataset.dir === 'down')  rotX = clamp(rotX - step, -MAX_ROT, MAX_ROT);
      if (btn.dataset.dir === 'left')  rotY = clamp(rotY - step, -MAX_ROT, MAX_ROT);
      if (btn.dataset.dir === 'right') rotY = clamp(rotY + step, -MAX_ROT, MAX_ROT);
      applyRotation();
    });
  });
  panReset.addEventListener('click', () => { rotX = 4; rotY = -14; applyRotation(); });

  // ---- Lightbox open/close — moves the same print element between the small
  // stage and the full lightbox, so there's one source of truth for its state ----
  function openZoom(){
    isZoomed = true;
    printWrap.classList.add('zoomed');
    lightboxStage.appendChild(printWrap);
    lightbox.classList.add('open');
    document.body.classList.add('zoom-active');
    document.body.style.overflow = 'hidden';
    applySize();
  }
  function closeZoom(){
    isZoomed = false;
    printWrap.classList.remove('zoomed');
    stageEl.appendChild(printWrap);
    lightbox.classList.remove('open');
    document.body.classList.remove('zoom-active');
    document.body.style.overflow = '';
    applySize();
  }

  zoomBtn.addEventListener('click', (e) => { e.stopPropagation(); openZoom(); });
  printWrap.addEventListener('click', () => { if (!isZoomed) openZoom(); });
  lightboxClose.addEventListener('click', closeZoom);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeZoom(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isZoomed) closeZoom(); });

  applyRotation();
  refresh();
</script>

</body>
</html>
